# ---- copy to .env and fill in. NEVER commit the real .env ----
ENVIRONMENT=production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://club.ranusnookers.in
CORS_ORIGINS=https://club.ranusnookers.in
COOKIE_SECURE=true
HTTP_PORT=80

# Database (compose builds DATABASE_URL from POSTGRES_PASSWORD; set DATABASE_URL to use a managed DB)
#POSTGRES_PASSWORD=change-me-strong-password
#DATABASE_URL=postgresql+psycopg://user:password@host:5432/ranu   # managed Postgres (Neon, Render, ...)
# DATABASE_URL=mysql+pymysql://ranu:pass@mysql-host:3306/ranu?charset=utf8mb4
#REDIS_URL=redis://redis:6379/0

# Auth — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Payments: mock | razorpay | stripe
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
CURRENCY=INR

# Object storage (S3-compatible: OCI / AWS S3 / Azure via gateway / MinIO)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Notifications: console | smtp / http / meta
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ranusnookers.in

SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_API_KEY=
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Devices / workers
DEVICE_OFFLINE_AFTER_SECONDS=90
WORKER_TICK_SECONDS=15
RATE_LIMIT_ENABLED=true
